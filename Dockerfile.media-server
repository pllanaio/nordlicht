FROM node:24-bookworm-slim
ENV NODE_ENV=production PORT=3001
WORKDIR /app
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --chown=node:node scripts/media-server.mjs ./scripts/media-server.mjs
COPY --chown=node:node src/lib/media-delivery/core.mjs ./src/lib/media-delivery/core.mjs
USER node
EXPOSE 3001
CMD ["node", "scripts/media-server.mjs"]
