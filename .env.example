# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mollie test key. Never expose this as NEXT_PUBLIC_*.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_WEBHOOK_SECRET=replace-me

# At least 32 random characters. Signs short-lived workspace entitlements after
# Mollie has authoritatively confirmed the first payment.
SUBSCRIPTION_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional server-side fallback. BYOK requests pass an ephemeral key instead.
OPENAI_API_KEY=

# Provider apps (connect after platform review)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_GRAPH_HOST=graph.instagram.com
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# OAuth CSRF state signing and AES-256-GCM token encryption.
# Generate independently, for example: openssl rand -base64 32
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Odoo 19 JSON-2 API
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_API_KEY=
