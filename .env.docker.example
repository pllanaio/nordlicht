# Copy this file to .env.docker and replace every change-me value.
# Start with: docker compose --env-file .env.docker up -d --build

APP_PORT=3000
APP_URL=http://localhost:3000

POSTGRES_DB=contentdock
POSTGRES_USER=contentdock_owner
POSTGRES_PASSWORD=change-me-database-owner-password
POSTGRES_APP_USER=contentdock_app
POSTGRES_APP_PASSWORD=change-me-database-app-password
DATABASE_POOL_MAX=10

# Generate independently with: npm run secret:generate
SUBSCRIPTION_SESSION_SECRET=change-me-subscription-secret
OAUTH_STATE_SECRET=change-me-oauth-secret
SOCIAL_TOKEN_ENCRYPTION_KEY=change-me-token-encryption-key
WORKSPACE_DATA_ENCRYPTION_KEY=change-me-workspace-data-key

# Keep this JSON single-quoted so Compose does not interpolate the $ signs
# inside scrypt password hashes.
INTERNAL_TEST_ACCOUNTS='[]'

MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_GRAPH_HOST=graph.instagram.com
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
